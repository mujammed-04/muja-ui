{
  "name": "@muja-ui/storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Storybook workbench for muja-ui — every component, both themes, light and dark",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "storybook build -o storybook-static",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@muja-ui/core": "workspace:*",
    "@muja-ui/icons": "workspace:*",
    "@muja-ui/theme-sdu": "workspace:*",
    "@muja-ui/tokens": "workspace:*",
    "@muja-ui/web": "workspace:*"
  },
  "devDependencies": {
    "@muja-ui/eslint-config": "workspace:*",
    "@muja-ui/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
